import("//base/security/access_token/access_token.gni")
import("//build/test.gni")

if (support_jsapi) {
ohos_unittest("libabilityaccessctrl_extension_test") {
  subsystem_name = "accesscontrol"
  module_out_path = module_output_path_unittest_accesstoken
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  include_dirs = [
    "${access_token_path}/frameworks/common/include",
    "${access_token_path}/interfaces/innerkits/accesstoken/include",
    "${access_token_path}/interfaces/innerkits/token_callback/include",
    "${access_token_path}/interfaces/innerkits/token_setproc/include",
    "${access_token_path}/interfaces/kits/js/napi/common/include",
    "${access_token_path}/interfaces/kits/js/napi/accesstoken/include",
  ]

  sources = [
    "${access_token_path}/frameworks/js/napi/accesstoken/src/napi_context_common.cpp",
    "accesstoken_kit_mock.cpp",
    "napi_extension_test.cpp",
  ]

  cflags_cc = access_token_cflags_cc

  deps = [
    "${access_token_path}/frameworks/common:accesstoken_common_cxx",
    "${access_token_path}/frameworks/js/napi/common:libnapi_common",
    "${access_token_path}/interfaces/innerkits/accesstoken:libaccesstoken_sdk",
    "${access_token_path}/interfaces/innerkits/token_callback:libtoken_callback_sdk",
    "${access_token_path}/interfaces/innerkits/token_setproc:libtokensetproc_shared",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:ability_context_native",
    "ability_runtime:ability_manager",
    "ability_runtime:abilitykit_native",
    "ability_runtime:napi_base_context",
    "ability_runtime:ui_extension",
    "ace_engine:ace_uicontent",
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_single",
    "libuv:uv",
    "napi:ace_napi",
    "node:node_header_notice",
    "window_manager:libwm",
  ]

  if (eventhandler_enable == true) {
    external_deps += [ "eventhandler:libeventhandler" ]
  }
  if (access_token_support_ime_extension && defined(global_parts_info.inputmethod_imf)) {
    external_deps += [ "imf:inputmethod_extension" ]
  }

  configs = [
    "${access_token_path}/config:access_token_compile_flags",
    "${access_token_path}/config:coverage_flags",
  ]
}
}

group("unittest") {
  testonly = true
  if (support_jsapi) {
    deps = [ ":libabilityaccessctrl_extension_test" ]
  }
}
