import("//base/security/access_token/access_token.gni")
import("//build/ohos.gni")

config("accesstoken_file_util_public_config") {
  include_dirs = [
    "include",
    "${access_token_path}/frameworks/common/include",
  ]
}

ohos_source_set("accesstoken_file_util") {
  subsystem_name = "security"
  part_name = "access_token"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  public_configs = [ ":accesstoken_file_util_public_config" ]

  include_dirs = [ "include" ]

  sources = [ "src/accesstoken_file_util.cpp" ]

  deps = [ "${access_token_path}/frameworks/common:accesstoken_static_log_for_nativetoken" ]

  external_deps = [ "bounds_checking_function:libsec_shared" ]

  configs = [
    "${access_token_path}/config:access_token_compile_flags",
    "${access_token_path}/config:coverage_flags",
  ]

  cflags_cc = access_token_cflags_cc

  if (build_selinux) {
    external_deps += [ "selinux_adapter:librestorecon" ]
    cflags_cc += [ "-DWITH_SELINUX" ]
  }
}
